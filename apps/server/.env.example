# LivePulse Backend Environment Variables
# Copy to .env for local development

# App
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8000

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Redis (optional - uses in-memory fallback if not set)
REDIS_URL=

# Database (optional - uses in-memory fallback if not set)
DATABASE_URL=

# Sandbox defaults
SANDBOX_DEFAULT_SCENARIO=ecommerce
SANDBOX_DEFAULT_SPEED=1.0

# External integrations (optional)
SLACK_WEBHOOK_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
```

